<resources>
    <style name="HomeEntry">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:descendantFocusability">blocksDescendants</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>
    <style name="HomeSectionTitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#748174</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="HomeEntryText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="HomeEntryTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#2B463D</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="HomeEntrySubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#879086</item>
    </style>
    <style name="HomeIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">11dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="HomeArrow">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:src">@drawable/ic_home_arrow</item>
        <item name="android:tint">#9DA89A</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
