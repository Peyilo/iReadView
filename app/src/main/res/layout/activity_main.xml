<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F7F0E5">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="iReadView · Widget 接入示例"
        android:textColor="#81756B"
        android:textSize="12sp" />

    <org.peyilo.ireadview.widget.ReaderView
        android:id="@+id/reader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:ireadPagingAxis="horizontal"
        app:ireadPageTurnEffect="none"
        app:ireadVolumeKeyPagingEnabled="false"
        app:ireadBodyTextSize="18sp"
        app:ireadPagePaddingStart="20dp"
        app:ireadPagePaddingEnd="20dp"
        app:ireadBodyFontFamily="sans-serif"
        app:ireadLineSpacingMultiplier="1.4"
        app:ireadParagraphSpacing="12dp"
        app:ireadTitleAlignment="center"
        app:ireadTitleSpacingAfter="20dp"
        app:ireadHeaderContent="chapter_title"
        app:ireadHeaderAlignment="start"
        app:ireadHeaderFontFamily="sans-serif"
        app:ireadHeaderPaddingBottom="12dp"
        app:ireadFooterContent="page_progress_and_time"
        app:ireadFooterAlignment="end"
        app:ireadFooterFontFamily="monospace"
        app:ireadFooterPaddingTop="12dp"
        app:ireadPageBackground="@drawable/reader_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/open_file" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="打开文件" />
        <Button android:id="@+id/sample_book" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="示例书籍" />
        <Button android:id="@+id/control_panel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="控制面板" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <Button android:id="@+id/previous" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="上一页" />
        <Button android:id="@+id/contents" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="目录" />
        <Button android:id="@+id/font" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="字号" />
        <Button android:id="@+id/mode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="模式" />
        <Button android:id="@+id/effect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="效果" />
        <Button android:id="@+id/next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="下一页" />
    </LinearLayout>
</LinearLayout>
