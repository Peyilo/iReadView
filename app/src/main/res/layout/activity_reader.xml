<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F6">
    <org.peyilo.ireadview.widget.ReaderView
        style="@style/ReaderDefaultStyle"
        android:id="@+id/reader"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:ireadPagingAxis="horizontal"
        app:ireadPageTurnEffect="none"
        app:ireadVolumeKeyPagingEnabled="false"
        />

    <LinearLayout
        android:id="@+id/txt_import_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:paddingTop="12dp"
        android:background="@drawable/home_card">
        <TextView android:id="@+id/txt_import_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#81756B" />
        <ProgressBar android:id="@+id/txt_import_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true" android:max="100" />
    </LinearLayout>
</FrameLayout>
